// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1775138331318118449 @name=vesktop
window-rule {
    match app-id="^vesktop$"
    open-maximized true
}

// @id=wr_1775139713377447468 @name=steam
window-rule {
    match app-id="^steam$"
    open-maximized true
}

// @id=wr_1775139734914518061 @name=steam
window-rule {
    match app-id="^steam$" title="^Friends List$"
    open-floating true
    max-width 600
    max-height 800
}

// @id=wr_1776258094670233657 @name=kitty
window-rule {
    match app-id="^kitty$"
}

// @id=wr_1776343967701825568 @name=Spotify
window-rule {
    match app-id="^Spotify$"
    open-maximized true
}

// @id=wr_1780757305295068570 @name=kitty
window-rule {
    match app-id="^kitty$"
    opacity 1.00
}

// @id=wr_1781081846254330185 @name=discord
window-rule {
    match app-id="^discord$"
    open-maximized true
}

// @id=wr_1783603413126875361 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    opacity 1.00
    background-effect {
        xray true
    }
}

// @id=wr_1783603601300196784 @name=^steam$
window-rule {
    match app-id="^steam$" title="^notificationtoasts_\\d+_desktop$" is-focused=false
    open-floating true
    default-floating-position x=0 y=0 relative-to="bottom-right"
}

// @id=wr_1783603617406198428 @name=firefox$
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    match app-id="zen" title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

// @id=wr_1783603677979974903 @name=zen
window-rule {
    match app-id="zen"
    open-maximized true
}

// @id=wr_1788969684956399592 @name=org.kde.dolphin
window-rule {
    match app-id="^org.kde.dolphin$"
    open-floating true
}

// @id=wr_1788971407262881979 @name=kitty
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}

// @id=wr_1789112669591097235 @name=Rule
window-rule {
    max-width 1820
}

// @id=wr_1789209306251880946 @name=steam
window-rule {
    match app-id="^steam$" title="^notificationtoasts_10016_desktop$" is-floating=true is-focused=false
    open-floating true
}

// @id=wr_1789209492880179466 @name=steam
window-rule {
    match app-id="^steam$" title="^notificationtoasts_10022_desktop$" is-floating=true is-active=false is-focused=false
    open-floating true
}
